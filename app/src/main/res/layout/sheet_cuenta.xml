<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja inferior "Tu cuenta" (CuentaHoja), se abre con la foto de perfil de la barra
    superior: datos de la cuenta, cerrar sesión y borrar la cuenta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Inicial del nombre (o del correo) sobre un círculo verde -->
        <TextView
            android:id="@+id/inicial_cuenta"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_status_dot"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/on_primary"
            android:textSize="20sp"
            tools:text="A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombre_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                tools:text="Ana López" />

            <TextView
                android:id="@+id/correo_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="13.5sp"
                tools:text="ana@correo.com" />

            <TextView
                android:id="@+id/proveedor_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:text="Sesión iniciada con Google" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_cerrar_sesion"
        style="@style/Widget.EcoVision.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:minHeight="48dp"
        android:text="@string/cuenta_cerrar_sesion"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_borrar_cuenta"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/cuenta_borrar"
        android:textColor="@color/error"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="20dp"
        app:iconTint="@color/error" />
</LinearLayout>
