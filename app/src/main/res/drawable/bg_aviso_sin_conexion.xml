<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo base rojo muy suave -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF5F5" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FECACA" />
        </shape>
    </item>
    <!-- Borde izquierdo de acento rojo -->
    <item android:right="1000dp">
        <shape android:shape="rectangle">
            <solid android:color="#C62828" />
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
        </shape>
    </item>
</layer-list>