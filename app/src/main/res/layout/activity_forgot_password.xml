<?xml version="1.0" encoding="utf-8"?>
<!--
    Recuperar contraseña (Fase 3): RecuperarPasswordActivity (Firebase Authentication).
    raiz_auth y cabecera_auth reciben los márgenes de las barras del sistema
    (AuthBaseActivity): la cabecera verde queda bajo la barra de estado.
-->
<ScrollView
    android:id="@+id/raiz_auth"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera verde compacta -->
        <FrameLayout
            android:id="@+id/cabecera_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:clipChildren="true"
            android:minHeight="176dp">

            <View
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-50dp"
                android:layout_marginEnd="-50dp"
                android:background="@drawable/bg_decor_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="44dp">

                <ImageButton
                    android:id="@+id/boton_atras_forgot"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_volver"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/forgot_titulo"
                    android:textColor="@color/on_primary"
                    android:textSize="26sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Aviso con acento morado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tip"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_action_icon_tile"
                    android:backgroundTint="@color/surface_container_lowest"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_help"
                    app:tint="@color/secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/forgot_descripcion"
                    android:textColor="@color/on_secondary_fixed_variant"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Correo -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EcoVision.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/login_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_email_forgot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Enviar enlace -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_enviar_reset"
                style="@style/Widget.EcoVision.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/forgot_enviar"
                android:textSize="15sp" />

            <!-- Volver al inicio de sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_volver_login"
                style="@style/Widget.EcoVision.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/forgot_volver_login"
                android:textSize="14sp"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
