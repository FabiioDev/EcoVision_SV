<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.MainActivity">

    <!-- TopAppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/surface"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/margin_mobile">

            <!-- logo: cuadro verde con hoja blanca -->
            <ImageView
                android:id="@+id/logo_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_logo_tile"
                android:contentDescription="@null"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_eco_leaf"
                app:tint="@color/on_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- "EcoVision" + " SV" en morado -->
            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/marca_ecovision"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@id/logo_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/app_title_sufijo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:layout_marginStart="5dp"
                android:text="@string/marca_sv"
                android:textColor="@color/secondary"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@id/app_title"
                app:layout_constraintBaseline_toBaselineOf="@id/app_title" />

            <LinearLayout
                android:id="@+id/api_status_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toStartOf="@id/profile_photo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="8dp">

                <!-- Punto de estado: color cambiado desde MainActivity -->
                <View
                    android:id="@+id/api_status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/status_connecting"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/api_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/api_status_connecting"
                    android:textSize="12sp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:textColor="@color/on_surface" />

            </LinearLayout>

            <!-- foto de perfil -->
            <ImageView
                android:id="@+id/profile_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_recycling"
                android:contentDescription="@string/cd_profile_photo"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Fragment host: HomeFragment / HistorialFragment / AboutFragment -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        tools:layout="@layout/fragment_home" />

    <!-- BottomNavBar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/surface"
        app:elevation="4dp"
        app:itemActiveIndicatorStyle="@style/Widget.EcoVision.NavIndicador"
        app:itemPaddingTop="8dp"
        app:itemPaddingBottom="10dp"
        app:itemIconTint="@color/nav_item_icon"
        app:itemTextColor="@color/nav_item_text"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>