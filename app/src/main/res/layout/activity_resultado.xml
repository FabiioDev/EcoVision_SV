<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_resultado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.ResultadoActivity">

    <!-- ─── Header ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón atrás -->
        <ImageButton
            android:id="@+id/boton_atras"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <!-- Título centrado -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/titulo_resultados"
            android:textAppearance="@style/TextAppearance.EcoVision.TitleLg"
            android:textColor="@color/on_surface" />

        <!-- Espacio simétrico al botón atrás -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- ─── Cuerpo scrolleable ─────────────────────────────── -->
    <ScrollView
        android:id="@+id/scroll_resultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_resultado"
        app:layout_constraintBottom_toTopOf="@id/footer_resultado">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- ══ Card imagen principal con bboxes ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Imagen con bounding boxes dibujados en código -->
                    <ImageView
                        android:id="@+id/imagen_resultado_principal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:minHeight="240dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/cd_imagen_resultado"
                        android:background="@color/surface_variant" />

                    <!-- ProgressBar mientras carga la imagen -->
                    <ProgressBar
                        android:id="@+id/progress_imagen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary" />

                    <!-- Badge: cantidad de objetos detectados -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_badge_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/texto_cantidad_detecciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="4 objetos identificados" />
                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Etiqueta sección carrusel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_detalle_residuo"
                android:textAppearance="@style/TextAppearance.EcoVision.LabelMd"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <!-- ══ Carrusel de detecciones ══ -->
            <!--
                Cada ítem ocupa el ancho completo del RecyclerView.
                PagerSnapHelper hace el snapping página a página.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carrusel_detecciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- ─── Footer con botones ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/footer_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Botón primario: Nueva detección -->
        <Button
            android:id="@+id/boton_nueva_deteccion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/primary"
            android:drawableStart="@drawable/ic_camera"
            android:drawablePadding="8dp"
            android:text="@string/boton_nueva_deteccion"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="16dp" />

        <!-- Botón secundario: Volver al inicio -->
        <Button
            android:id="@+id/boton_volver_inicio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_variant"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="8dp"
            android:text="@string/boton_volver_inicio"
            android:textColor="@color/on_surface"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>