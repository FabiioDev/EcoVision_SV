<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.EcoVision.ScrollIndicador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_mobile"
        android:paddingTop="@dimen/stack_lg"
        android:paddingBottom="40dp">

        <!-- Hero: mismo estilo que la action card "Escanear Residuo" del home -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="1dp"
            app:strokeColor="@color/action_scan_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-32dp"
                    android:layout_marginBottom="-32dp"
                    android:background="@drawable/bg_action_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_action_icon_tile"
                            android:backgroundTint="@color/surface_container_lowest"
                            android:contentDescription="@null"
                            android:elevation="1dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_recycling_v2"
                            app:tint="@color/primary" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_action_pill"
                            android:backgroundTint="@color/on_primary_20"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="@string/about_version"
                            android:textColor="@color/on_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/about_app_nombre"
                        android:textColor="@color/on_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="40dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/about_tagline"
                        android:textColor="@color/on_primary_90"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- El proyecto -->
        <TextView
            style="@style/Widget.EcoVision.SectionLabel"
            android:text="@string/about_section_proyecto" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EcoVision.SurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:lineSpacingMultiplier="1.45"
                android:text="@string/about_descripcion"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tecnologías: las filas se agregan desde AboutFragment -->
        <TextView
            style="@style/Widget.EcoVision.SectionLabel"
            android:text="@string/about_section_tecnologias" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EcoVision.SurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/contenedor_tecnologias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Modelo de IA -->
        <TextView
            style="@style/Widget.EcoVision.SectionLabel"
            android:text="@string/about_section_modelo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EcoVision.SurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_action_icon_tile"
                        android:backgroundTint="@color/primary_fixed"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/about_modelo_nombre"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/about_modelo_descripcion"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />

                <!-- Parámetros reales del pipeline (ImageResizer / InferenciaRepository) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.EcoVision.InfoPill"
                        android:text="@string/about_modelo_clases" />

                    <TextView
                        style="@style/Widget.EcoVision.InfoPill"
                        android:layout_marginStart="6dp"
                        android:text="@string/about_modelo_entrada" />

                    <TextView
                        style="@style/Widget.EcoVision.InfoPill"
                        android:layout_marginStart="6dp"
                        android:text="@string/about_modelo_umbral" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Créditos -->
        <TextView
            style="@style/Widget.EcoVision.SectionLabel"
            android:text="@string/about_section_creditos" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EcoVision.SurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp"
                    android:lineSpacingMultiplier="1.45"
                    android:text="@string/about_creditos"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surface_container" />

                <!-- Enlace al repositorio -->
                <LinearLayout
                    android:id="@+id/enlace_github"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_code"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/about_github"
                        android:textColor="@color/secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_open_in_new"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
