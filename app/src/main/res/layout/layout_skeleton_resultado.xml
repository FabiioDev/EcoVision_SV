<?xml version="1.0" encoding="utf-8"?>
<!--
    Skeleton de ResultadoActivity mientras se espera la respuesta de la API.
    Replica la estructura del resultado: imagen, etiqueta de sección y card del carrusel.
    Los bloques de skeleton_bloques pulsan desde ResultadoActivity.mostrarSkeleton().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:id="@+id/skeleton_bloques"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen principal -->
        <View
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_skeleton_imagen" />

        <!-- Etiqueta "Detalle del residuo" -->
        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Card del carrusel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_skeleton" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="96dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado: fuera de skeleton_bloques para que no pulse -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/analizando_residuo"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
