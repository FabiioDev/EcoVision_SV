<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja inferior con el texto completo de un anuncio (TablonAnuncios).
    Con varios anuncios se recorren con Anterior / Siguiente sin cerrarla.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_action_icon_tile"
            android:backgroundTint="@color/primary_container"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_campaign"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/titulo_hoja_anuncio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            tools:text="Anuncio 1 de 3" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/texto_hoja_anuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/on_surface"
            android:textColorLink="@color/secondary"
            android:textIsSelectable="false"
            android:textSize="14.5sp"
            tools:text="Ya está disponible la nueva versión de la app. Descárgala en https://example.com/descarga" />
    </androidx.core.widget.NestedScrollView>

    <!-- Anterior / Siguiente: solo con más de un anuncio (TablonAnuncios oculta la fila).
         Botones de 48 dp de alto como mínimo, el tamaño cómodo para tocar. -->
    <LinearLayout
        android:id="@+id/fila_navegacion_anuncio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_anuncio_anterior"
            style="@style/Widget.EcoVision.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/anuncio_anterior" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_anuncio_siguiente"
            style="@style/Widget.EcoVision.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/anuncio_siguiente" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_anuncio_cerrar"
        style="@style/Widget.EcoVision.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/anuncio_cerrar" />
</LinearLayout>
