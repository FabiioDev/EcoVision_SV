<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/stack_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_mobile"
            android:paddingTop="@dimen/stack_lg">

            <!-- Saludo -->
            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting"
                android:textAppearance="@style/TextAppearance.EcoVision.HeadlineLgMobile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_sm"
                android:text="@string/home_subtitle"
                android:textAppearance="@style/TextAppearance.EcoVision.BodyLg" />

            <!-- mensaje sin conexión -->
            <LinearLayout
                android:id="@+id/texto_sin_conexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_lg"
                android:background="@drawable/bg_aviso_sin_conexion"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi_off"
                    app:tint="@color/status_disconnected" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mensaje_sin_conexion"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- Encabezado de acciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:text="@string/home_acciones_rapidas"
                    android:textAppearance="@style/TextAppearance.EcoVision.LabelMd"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="2dp"
                    android:gravity="center_vertical"
                    android:text="@string/home_clasificacion_ia"
                    android:textAppearance="@style/TextAppearance.EcoVision.LabelMd"
                    android:textColor="@color/primary"
                    app:drawableStartCompat="@drawable/ic_auto_awesome"
                    app:drawableTint="@color/primary" />
            </LinearLayout>

            <!-- Action card 1: Escanear Residuo (hero) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/action_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_md"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/primary_container"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="1dp"
                app:rippleColor="@color/on_primary_20"
                app:strokeColor="@color/action_scan_stroke"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Brillo decorativo en la esquina inferior derecha -->
                    <View
                        android:layout_width="144dp"
                        android:layout_height="144dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-24dp"
                        android:layout_marginBottom="-24dp"
                        android:background="@drawable/bg_action_glow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_action_icon_tile"
                                android:backgroundTint="@color/surface_container_lowest"
                                android:contentDescription="@null"
                                android:elevation="1dp"
                                android:padding="14dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/primary" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="@string/action_scan"
                            android:textColor="@color/on_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="40dp"
                            android:lineSpacingMultiplier="1.3"
                            android:text="@string/action_scan_descripcion"
                            android:textColor="@color/on_primary_90"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/on_primary_15" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/action_scan_cta"
                                android:textColor="@color/on_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_action_circle"
                                android:backgroundTint="@color/on_primary"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action card 2: Subir Imagen -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/action_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_variant_60"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_action_icon_tile"
                            android:backgroundTint="@color/secondary_fixed"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/ic_add_photo_alternate"
                            app:tint="@color/secondary" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_action_pill"
                            android:backgroundTint="@color/surface_container"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/action_upload_badge"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/action_upload"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/action_upload_descripcion"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/surface_container" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_upload_cta"
                            android:textColor="@color/secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_action_circle"
                            android:backgroundTint="@color/surface_container_high"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tip del día -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_lg"
                android:text="@string/tip_of_day_label"
                android:textAppearance="@style/TextAppearance.EcoVision.LabelMd" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stack_sm"
                android:background="@drawable/bg_card_tip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/gutter">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_leaf_circle"
                    android:padding="8dp"
                    android:src="@drawable/ic_recycling_v3"
                    app:tint="@color/on_secondary"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_of_day_title"
                        android:textColor="@color/on_secondary_fixed"
                        android:textAppearance="@style/TextAppearance.EcoVision.TitleLg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stack_sm"
                        android:text="@string/tip_of_day_body"
                        android:textColor="@color/on_secondary_fixed_variant"
                        android:textAppearance="@style/TextAppearance.EcoVision.BodyMd"
                        tools:ignore="VisualLintLongText" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>