<?xml version="1.0" encoding="utf-8"?><!--
    Ítem del carrusel de detecciones en ResultadoActivity.
    Ocupa el ancho completo del RecyclerView (match_parent).
    El recorte se dibuja en código con el bbox exacto de la detección;
    El color de la franja, el badge y la barra depende del índice (igual que la caja);
    el chip usa el color fijo de la categoría (CategoriaEstilo).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.EcoVision.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recorte del objeto: fitCenter para no deformar ni cortar el bbox -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/surface_container">

                <ImageView
                    android:id="@+id/imagen_recorte"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_recorte_deteccion"
                    android:scaleType="fitCenter" />

                <!-- Badge numérico (coincide con la etiqueta [N] de la imagen principal) -->
                <TextView
                    android:id="@+id/numero_deteccion"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_numero_badge"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:textColor="@color/on_bbox"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </FrameLayout>

            <!-- Franja con el color de la detección -->
            <View
                android:id="@+id/franja_color"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                tools:background="#FF26A641" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_categoria"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_chip_categoria"
                        android:gravity="center"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/categoria_otro_texto"
                        android:textSize="13sp"
                        tools:backgroundTint="@color/categoria_plastico_fondo"
                        tools:text="Plástico"
                        tools:textColor="@color/categoria_plastico_texto" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/texto_confianza_deteccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:includeFontPadding="false"
                            android:textColor="@color/on_surface"
                            android:textSize="26sp"
                            tools:text="98%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_confianza"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/barra_confianza"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    tools:progress="98" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/surface_container" />

                <!-- Consejo de reciclaje para la categoría -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_action_icon_tile"
                        android:backgroundTint="@color/secondary_fixed"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_recycling"
                        app:tint="@color/secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_consejo"
                            android:textColor="@color/on_secondary_container"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- minLines iguala la altura de las cards del carrusel -->
                        <TextView
                            android:id="@+id/texto_consejo_categoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingMultiplier="1.3"
                            android:maxLines="4"
                            android:minLines="3"
                            android:ellipsize="end"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            tools:text="Deposita en el contenedor amarillo. Enjuaga el envase antes de reciclarlo para evitar contaminar otros materiales." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
