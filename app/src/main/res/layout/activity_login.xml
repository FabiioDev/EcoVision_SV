<?xml version="1.0" encoding="utf-8"?>
<!--
    Inicio de sesión (Fase 3): LoginActivity (Firebase Authentication).
    raiz_auth y cabecera_auth reciben los márgenes de las barras del sistema
    (AuthBaseActivity): la cabecera verde queda bajo la barra de estado.
-->
<ScrollView
    android:id="@+id/raiz_auth"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera verde con marca -->
        <FrameLayout
            android:id="@+id/cabecera_auth"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/primary"
            android:clipChildren="true">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-60dp"
                android:layout_marginBottom="-90dp"
                android:background="@drawable/bg_decor_circle"
                android:backgroundTint="@color/secondary" />

            <View
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-50dp"
                android:layout_marginEnd="-50dp"
                android:background="@drawable/bg_decor_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_action_icon_tile"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_eco_leaf"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/about_app_nombre"
                    android:textColor="@color/on_primary"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/auth_header_subtitulo"
                    android:textColor="@color/on_primary_90"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Formulario sobre una hoja blanca que se superpone a la cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/login_titulo"
                android:textColor="@color/on_surface"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <!-- Aviso de mantenimiento (maintenance_mode, config pública): solo informa;
                 se puede iniciar sesión, lo que se bloquea es la detección. -->
            <LinearLayout
                android:id="@+id/aviso_mantenimiento_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_aviso_mantenimiento"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_build"
                    app:tint="@color/aviso_mantenimiento_icono" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="@string/aviso_mantenimiento_titulo"
                        android:textColor="@color/aviso_mantenimiento_texto"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/texto_mantenimiento_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        tools:text="Estamos mejorando el servicio de detección." />
                </LinearLayout>
            </LinearLayout>

            <!-- Correo -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EcoVision.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EcoVision.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/login_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ¿Olvidaste tu contraseña? -->
            <TextView
                android:id="@+id/enlace_olvide_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:paddingHorizontal="4dp"
                android:text="@string/login_olvide_password"
                android:textColor="@color/secondary"
                android:textSize="13sp" />

            <!-- Iniciar sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_login"
                style="@style/Widget.EcoVision.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/login_iniciar"
                android:textSize="15sp" />

            <!-- Divisor "o" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/outline_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="@string/o"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/outline_variant" />
            </LinearLayout>

            <!-- Google: ícono original a color (iconTint nulo en el estilo) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_google"
                style="@style/Widget.EcoVision.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/login_con_google"
                app:icon="@drawable/ic_google" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Enlace a registro (se oculta con registration_enabled=false) -->
            <LinearLayout
                android:id="@+id/contenedor_registro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sin_cuenta"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/enlace_registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/login_registrate"
                    android:textColor="@color/secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
