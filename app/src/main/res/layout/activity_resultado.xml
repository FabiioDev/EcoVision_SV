<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_resultado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.ResultadoActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón atrás -->
        <ImageButton
            android:id="@+id/boton_atras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <!-- Título centrado -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/titulo_resultados"
            android:textAppearance="@style/TextAppearance.EcoVision.TitleLg"
            android:textColor="@color/on_surface" />

        <!-- Espacio simétrico al botón atrás -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <!-- Cuerpo scrolleable -->
    <ScrollView
        android:id="@+id/scroll_resultado"
        style="@style/Widget.EcoVision.ScrollIndicador"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_resultado"
        app:layout_constraintBottom_toTopOf="@id/footer_resultado">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Card imagen principal con bboxes  -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Imagen con bounding boxes dibujados en código -->
                    <ImageView
                        android:id="@+id/imagen_resultado_principal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:minHeight="240dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/cd_imagen_resultado"
                        android:background="@color/surface_variant" />

                    <!-- ProgressBar mientras carga la imagen -->
                    <ProgressBar
                        android:id="@+id/progress_imagen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary" />

                    <!-- Badge: cantidad de objetos detectados -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_badge_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/texto_cantidad_detecciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="4 objetos identificados" />
                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Etiqueta de la sección + contador "1 de N" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="@string/label_detalle_residuo"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.EcoVision.LabelMd" />

                <!-- Se oculta cuando hay una sola detección -->
                <TextView
                    android:id="@+id/texto_contador_carrusel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:textColor="@color/on_secondary_container"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="1 de 3"
                    tools:visibility="visible" />
            </LinearLayout>

            <!--
                Carrusel de detecciones. Con varias, cada tarjeta mide el ancho menos
                carrusel_asomo (en código) para que asome la vecina; la última se
                alinea a la derecha y deja asomar la anterior (SnapInicioFin).
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carrusel_detecciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Puntos: el activo es una píldora morada (se crean en código) -->
            <LinearLayout
                android:id="@+id/pager_dots"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </LinearLayout>
    </ScrollView>

    <!-- Skeleton mientras se espera la respuesta de la API -->
    <include
        android:id="@+id/skeleton_resultado"
        layout="@layout/layout_skeleton_resultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header_resultado"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Footer con botones -->
    <LinearLayout
        android:id="@+id/footer_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_footer_resultado"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Botón primario: Nueva Detección -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_nueva_deteccion"
            style="@style/Widget.EcoVision.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="@string/boton_nueva_deteccion"
            android:textSize="16sp"
            app:elevation="2dp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="22dp" />

        <!-- Botón secundario: Volver al Inicio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver_inicio"
            style="@style/Widget.EcoVision.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/boton_volver_inicio"
            android:textSize="14sp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>