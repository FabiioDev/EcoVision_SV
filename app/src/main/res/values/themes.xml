    <style name="Theme.EcoVisionSV" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" >true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <!-- Full-screen theme used by the scanner (dark, no top inset background) -->
    <style name="Theme.EcoVisionSV.Scanner" parent="Theme.EcoVisionSV">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" >false</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- ===== Text Appearances (mirrors DESIGN.md typography scale) ===== -->
    <style name="TextAppearance.EcoVision.HeadlineLgMobile" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.EcoVision.HeadlineLg" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.EcoVision.TitleLg" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.EcoVision.BodyLg" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/app_font_family</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.EcoVision.BodyMd" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/app_font_family</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.EcoVision.LabelLg" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.EcoVision.LabelMd" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- ===== Component styles ===== -->
    <style name="Widget.EcoVision.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoVision.LabelLg</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>

    <style name="Widget.EcoVision.CircleIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:background">@drawable/bg_circle_scrim</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Botón secundario de ResultadoActivity (pill con borde) -->
    <style name="Widget.EcoVision.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoVision.LabelLg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/primary_fixed</item>
    </style>

    <!-- Card blanca con borde, mismo estilo que la action card "Subir Imagen" -->
    <!-- Basado en Outlined: Elevated trae un stateListAnimator con atributos de tema
         que no se resuelven al aplicarlo como style y cierra la app al inflar -->
    <style name="Widget.EcoVision.SurfaceCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:stateListAnimator">@null</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/outline_variant_60</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Encabezado de sección en mayúsculas (home / about) -->
    <style name="Widget.EcoVision.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/stack_lg</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.EcoVision.LabelMd</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Etiqueta pequeña de dato (about: parámetros del modelo) -->
    <style name="Widget.EcoVision.InfoPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_action_pill</item>
        <item name="android:backgroundTint">@color/primary_fixed</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/on_primary_fixed_variant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>