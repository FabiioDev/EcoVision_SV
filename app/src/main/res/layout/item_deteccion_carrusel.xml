<?xml version="1.0" encoding="utf-8"?>
<!--
    Ítem del carrusel de detecciones en ResultadoActivity.
    Ocupa el ancho completo del RecyclerView (match_parent).
    El color de fondo del card_deteccion_container y el color de la
    barra de progreso se aplican desde código según el índice de detección.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:id="@+id/card_deteccion_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Columna izquierda: recorte de la detección -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginEnd="14dp"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/imagen_recorte"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_recorte_imagen"
                    android:contentDescription="@string/cd_recorte_deteccion" />

                <!-- Badge numérico sobre la imagen -->
                <TextView
                    android:id="@+id/numero_deteccion"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:elevation="2dp"
                    android:background="@drawable/bg_numero_badge"
                    tools:text="1" />

            </FrameLayout>

            <!-- Columna derecha: información de la detección -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Categoría -->
                <TextView
                    android:id="@+id/texto_categoria_deteccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    tools:text="Plástico" />

                <!-- Porcentaje de confianza -->
                <TextView
                    android:id="@+id/texto_confianza_deteccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="98%"
                    tools:textColor="@color/primary" />

                <!-- Barra de confianza -->
                <ProgressBar
                    android:id="@+id/barra_confianza"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    tools:progress="98" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="#1A000000" />

                <TextView
                    android:id="@+id/texto_consejo_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/on_surface_variant"
                    tools:text="Deposita en el contenedor amarillo. Enjuaga el envase antes de reciclarlo." />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>