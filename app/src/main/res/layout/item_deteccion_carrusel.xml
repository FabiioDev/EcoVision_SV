<?xml version="1.0" encoding="utf-8"?><!--
    Ítem del carrusel de detecciones en ResultadoActivity.
    Ocupa el ancho completo del RecyclerView (match_parent).
    El color de fondo del card_deteccion_container y el color de la
    barra de progreso se aplican desde código según el índice de detección.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:id="@+id/card_deteccion_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:id="@+id/franja_color"
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <!-- Imagen recortada -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:outlineProvider="background"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imagen_recorte"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_recorte_imagen"
                    android:contentDescription="@string/cd_recorte_deteccion"
                    android:scaleType="centerCrop" />

                <!-- Badge numérico -->
                <TextView
                    android:id="@+id/numero_deteccion"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_numero_badge"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="1" />

            </FrameLayout>

            <!-- Columna de texto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="14dp">

                <!-- Chip de categoría-->
                <TextView
                    android:id="@+id/chip_categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_chip_categoria"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:background="#FF26A641"
                    tools:text="Plástico" />

                <!-- Porcentaje de confianza en grande -->
                <TextView
                    android:id="@+id/texto_confianza_deteccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="98%" />

                <!-- Barra de confianza -->
                <ProgressBar
                    android:id="@+id/barra_confianza"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    tools:progress="98" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="#12000000" />

                <!-- Consejo genérico -->
                <TextView
                    android:id="@+id/texto_consejo_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="2"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp"
                    tools:text="Deposita en el contenedor amarillo. Enjuaga el envase antes de reciclarlo." />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>